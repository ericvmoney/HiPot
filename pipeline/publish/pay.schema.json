{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pay bands file",
  "description": "The shape of site/data/pay.json, written by pipeline.publish and read by site/pay.html. Owned by workstream A4. Bands summarise pay that employers published; nothing is estimated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pay_version", "generated_at", "scope", "categories", "min_postings", "counts", "labels", "bands"],
  "properties": {
    "pay_version": {"const": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["listed", "all"]},
    "categories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
                   "description": "The company categories the bands are drawn from: the board's default (clean tech, decision 23). Empty in a development build, which keeps every role."},
    "min_postings": {"type": "integer", "minimum": 1, "description": "Postings a band needs before it shows figures."},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postings", "year", "hour", "left_out"],
      "properties": {
        "postings": {"type": "integer", "minimum": 0, "description": "Roles whose published US-dollar range entered the bands."},
        "year": {"type": "integer", "minimum": 0},
        "hour": {"type": "integer", "minimum": 0},
        "left_out": {"type": "integer", "minimum": 0, "description": "Roles with published pay that could not enter a band: another currency, no low end, or outside the US."}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "levels", "markets"],
      "patternProperties": {
        "^[a-z]+$": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {"id": {"$ref": "#/$defs/slug"}, "label": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "gov": {
      "description": "Government wage reference points (BLS OEWS) for metro markets, copied from data/pay/ by the publish step. Never used for grades.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "year", "top_code", "occupations", "rules", "figures"],
      "properties": {
        "source": {"type": "string"},
        "year": {"type": "integer"},
        "top_code": {"type": "object", "additionalProperties": false, "required": ["year", "hour"],
                     "properties": {"year": {"type": "number"}, "hour": {"type": "number"}}},
        "occupations": {"type": "object", "additionalProperties": {"type": "string"}},
        "rules": {"type": "object", "additionalProperties": {
          "type": "array", "prefixItems": [{"type": "string"}, {"enum": ["p25", "median", "p75", "p90"]}], "minItems": 2, "maxItems": 2},
          "description": "'group|level' -> [occupation, statistic]."},
        "figures": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["area"],
          "properties": {"area": {"type": "string"}, "top": {"type": "array", "items": {"type": "string"}}},
          "patternProperties": {"^(year|hour)_(p25|median|p75|p90)$": {"type": ["number", "null"]}},
          "additionalProperties": false}},
          "description": "metro -> occupation -> the figures the page uses, and the BLS area they come from."}
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["per", "g", "l", "m", "n"],
        "properties": {
          "per": {"enum": ["year", "hour"]},
          "g": {"type": "string", "pattern": "^[df]-[a-z0-9]+(-[a-z0-9]+)*$", "description": "Role group: d- plus a discipline, or f- plus a function."},
          "l": {"$ref": "#/$defs/slug", "description": "Level id, or 'none'."},
          "m": {"$ref": "#/$defs/slug", "description": "Metro id, 'remote' or 'us'."},
          "n": {"type": "integer", "minimum": 1},
          "lo": {"type": "number", "minimum": 0, "description": "Median low end. Present only with min_postings or more."},
          "hi": {"type": "number", "minimum": 0},
          "mid": {"type": "number", "minimum": 0}
        },
        "dependentRequired": {"lo": ["hi", "mid"], "hi": ["lo", "mid"], "mid": ["lo", "hi"]}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
  }
}
