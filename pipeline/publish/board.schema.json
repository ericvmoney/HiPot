{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Board data file",
  "description": "The shape of site/data/board.json, written by pipeline.publish and read by site/index.html. Owned by workstream A4; it is an internal format between the publish step and the page, not one of the shared contracts. A missing optional field means 'not stated'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["board_version", "generated_at", "source", "scope", "counts", "taxonomy", "companies", "roles"],
  "properties": {
    "board_version": {"const": 0},
    "generated_at": {"type": "string", "format": "date-time", "description": "Copied from the jobs file: when the role data was generated."},
    "source": {"type": "string"},
    "scope": {"enum": ["listed", "all"], "description": "'all' is a development build that includes unlisted companies. Never publish it."},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "companies", "roles_left_out", "companies_provisional"],
      "properties": {
        "roles": {"type": "integer", "minimum": 0},
        "companies": {"type": "integer", "minimum": 0},
        "roles_left_out": {"type": "integer", "minimum": 0},
        "companies_provisional": {"type": "integer", "minimum": 0, "description": "Companies in this file whose climate tier is not yet approved."}
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disciplines", "levels", "sectors", "stages", "workplace", "metros", "climate_tiers"],
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {"id": {"$ref": "#/$defs/slug"}, "label": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "companies": {
      "description": "Keyed by company id. Only companies with at least one role in this file.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tier"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "tier": {"enum": ["core", "enabling", "out", "unscreened"]},
          "reason": {"type": "string", "minLength": 1},
          "provisional": {"const": true, "description": "Present when the tier has not been approved."},
          "sectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "stage": {"$ref": "#/$defs/slug"},
          "hq": {"type": "string", "minLength": 1},
          "website": {"type": "string", "pattern": "^https://"},
          "careers": {"type": "string", "pattern": "^https://"},
          "unlisted": {"const": true, "description": "Present only in a development build."}
        }
      }
    },
    "roles": {
      "description": "Newest first.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "co", "title", "url", "seen"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "co": {"$ref": "#/$defs/slug", "description": "A key of 'companies'."},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://", "description": "The posting on the company's own board."},
          "loc": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "metros": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "wp": {"enum": ["onsite", "hybrid", "remote"]},
          "disc": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}},
          "level": {"$ref": "#/$defs/slug"},
          "emp": {"enum": ["full-time", "part-time", "contract", "intern"]},
          "pay": {
            "description": "As the employer published it. Never an estimate.",
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "cur", "per"],
            "properties": {
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 0},
              "cur": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "per": {"enum": ["year", "hour"]}
            }
          },
          "posted": {"type": "string", "format": "date"},
          "seen": {"type": "string", "format": "date", "description": "The day the role was first seen."},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}
  }
}
